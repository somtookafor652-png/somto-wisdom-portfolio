# Firebase service account values for server-side Firestore access.
# FIREBASE_PRIVATE_KEY should keep the escaped "\n" line breaks.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENTS\n-----END PRIVATE KEY-----\n
FIREBASE_PORTFOLIO_DOCUMENT=site/portfolio

# Generate secrets with `openssl rand -base64 32`
AUTH_SECRET=replace-with-random-secret
AUTH_URL=http://localhost:3000/api/auth
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_SESSION_SECRET=replace-with-random-secret
